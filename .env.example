# mqvpn server — configuration
#
# Copy to .env (or paste into Dokploy -> your Compose service -> Environment).
# Every variable is optional; the value shown is the default. Changes take
# effect on the next deploy/restart. Credentials are NOT regenerated.

# ---------------------------------------------------------------------------
# Version / build
# ---------------------------------------------------------------------------
# mqvpn release to install. When you change it, also update the checksums
# below from the release's SHA256SUMS file (and the commit for source builds):
#   https://github.com/mp0rta/mqvpn/releases/download/v<VERSION>/SHA256SUMS
MQVPN_VERSION=0.19.2
MQVPN_SHA256_AMD64=d337086464b04ae90653a2a4402aa56f19fb001dcea60d0eb4e404d1e4bba863
MQVPN_SHA256_ARM64=a4b7dfe9510a949c7d9cd81679071589c6d2efea2dfd735623f5cadc8abd6c5a
# release = official prebuilt binary (fast); source = compile the tag (~5-15 min)
MQVPN_BUILD_METHOD=release
# Commit of tag v$MQVPN_VERSION, checked when MQVPN_BUILD_METHOD=source
MQVPN_GIT_COMMIT=74e2cd09b1cc811902e795a597390ceef503ad7e

# ---------------------------------------------------------------------------
# Listening
# ---------------------------------------------------------------------------
# UDP port of the VPN. Open it in the VPS/cloud firewall (UDP, not TCP).
# Dokploy's Traefik already uses UDP 443 for HTTP/3; on a Dokploy server use
# another port such as 8443 unless you freed 443/udp (README "Port conflicts").
MQVPN_PORT=443
# Local address to bind (0.0.0.0 = all IPv4 addresses; '::' = IPv6 only).
MQVPN_LISTEN_ADDR=0.0.0.0
# Public IP or DNS name clients connect to. Only used for the connection
# summary (mqvpn-info) and as the name in a newly generated self-signed
# certificate. Empty = auto-detected from the default route.
MQVPN_PUBLIC_HOST=

# ---------------------------------------------------------------------------
# Tunnel addressing
# ---------------------------------------------------------------------------
# IPv4 pool for clients (/16 to /30). Must not overlap host networks (checked
# at start; Hetzner/DigitalOcean private networks often use 10.0.0.0/16).
MQVPN_SUBNET=10.70.0.0/24
# IPv6 inside the tunnel: auto | off | an IPv6 prefix /96../126 (e.g. ULA)
#   auto: enabled only if the host has IPv6 internet; a random ULA /112 is
#         generated once and kept. Client IPv6 is NATed (NAT66) to the host.
MQVPN_SUBNET6=auto
# TUN device name on the host (max 15 chars). Change only to run several
# instances on one host.
MQVPN_TUN_NAME=mqvpn0
# TUN MTU 1280-9000; empty = automatic (~1382)
MQVPN_MTU=
MQVPN_MAX_CLIENTS=64
# debug | info | warn | error
MQVPN_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authentication (pre-shared keys)
# ---------------------------------------------------------------------------
# Empty = generate a random key on first start and keep it in the volume
# (recommended; it is never printed to the logs). Show it with:
#   docker compose exec mqvpn mqvpn-info --show-key
# Set a value only to reuse an existing key (e.g. migrating a server).
MQVPN_AUTH_KEY=
# Accept the global key above (true) or only the per-user keys below (false).
MQVPN_GLOBAL_KEY=true
# Optional per-device keys, comma or space separated names, e.g. "phone,laptop".
# A key is generated once per name; removing a name revokes its access.
MQVPN_USERS=

# ---------------------------------------------------------------------------
# TLS certificate
# ---------------------------------------------------------------------------
# Empty = self-signed certificate generated once in the volume. In the Android
# app enable "Trust self-signed certificate".
# To use a trusted certificate (e.g. Let's Encrypt), mount its directory and
# point to the files INSIDE the container (use the full chain):
#   MQVPN_TLS_HOST_DIR=/etc/letsencrypt
#   MQVPN_TLS_CERT_FILE=/etc/mqvpn-tls/live/vpn.example.com/fullchain.pem
#   MQVPN_TLS_KEY_FILE=/etc/mqvpn-tls/live/vpn.example.com/privkey.pem
# Restart the container after a renewal (mqvpn reads the certificate at start).
MQVPN_TLS_HOST_DIR=./tls
MQVPN_TLS_CERT_FILE=
MQVPN_TLS_KEY_FILE=

# ---------------------------------------------------------------------------
# Multipath behaviour (server side)
# ---------------------------------------------------------------------------
# wlb (default, bandwidth aggregation) | minrtt | wlb_udp_pin | backup_fec
MQVPN_SCHEDULER=wlb
# Let a client choose its own download scheduler
MQVPN_ALLOW_CLIENT_SCHEDULER=true
# Congestion control: bbr2 | bbr | cubic
MQVPN_CC=bbr2
# Speculative duplication of server->client packets: off | deadline | idle
MQVPN_REINJECTION=off
# Offer the hybrid TCP lane and the reorder buffer. Each is used only by
# clients that enable it too (Android: "Carry TCP over its own lane",
# "Smooth out packet order").
MQVPN_HYBRID=true
MQVPN_REORDER=true

# ---------------------------------------------------------------------------
# Control API (local, unauthenticated, bound to the host's 127.0.0.1 only)
# ---------------------------------------------------------------------------
# Used by the health check, the watchdog and `mqvpn-paths`. 0 = disabled.
MQVPN_CONTROL_PORT=19090

# ---------------------------------------------------------------------------
# Networking / firewall
# ---------------------------------------------------------------------------
# Outbound interface for NAT: auto (default route) | any | <interface>
MQVPN_NAT_INTERFACE=auto
# Stop VPN clients from reaching private/internal networks through the server
# (RFC1918, CGNAT, link-local incl. cloud metadata 169.254.169.254, unpublished
# Docker containers). Internet access is unaffected.
MQVPN_BLOCK_PRIVATE_NETWORKS=true
# Also accept the VPN port in the host's INPUT chain (useful with UFW). The
# rule is removed when the container stops. Cloud firewalls still need it.
MQVPN_FIREWALL_OPEN_PORT=false
# auto | nft | legacy — must match the host's iptables; auto detects it
MQVPN_IPTABLES_BACKEND=auto
# Skip the "subnet overlaps a host network" safety check
MQVPN_SKIP_SUBNET_CHECK=false
